# ==============================================================================
# 🔙 RENTAL HUB — BACKEND API ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to '.env' inside the backend folder before running the server:
#   $ cp env.example .env
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated additional allowed origins
CORS_ORIGINS=http://localhost:3000
# Use "none" for a production frontend hosted on a different site (HTTPS required).
COOKIE_SAME_SITE=lax

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=rental_system
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_MAX_USES=7500

# Authentication Security
# Generate a secure 64-byte hex key using:
#   $ node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here

# Google OAuth 2.0 (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
