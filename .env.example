# ==============================================================================
# 🏢 RENTAL HUB — CORE ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to individual service directories:
#   - For backend: Copy to backend/.env
#   - For frontend: Copy to frontend/.env.local (and set NEXT_PUBLIC_API_URL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔙 BACKEND API CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
# Port the Express API binds to
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=rental_system

# Authentication
# Generate a secure key using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here

# ------------------------------------------------------------------------------
# 🚀 FRONTEND CLIENT CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
# Path pointing to the gateway Express API endpoints
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
